:root {
    --bg: #141026;
    --panel: #1c1733;
    --ink: #ece6fa;
    --muted: #a79fc2;
    --line: #342b55;
    --gold: #f2b441;
    --gold-bg: #3b2e15;
    --violet: #a88be0;
    --low: #a49dbd;
    --rare: #5fb2e6;
    --epic: #ef6b90;
    --legend: #ff8a3d;
    --ok: #5cc28d;
    --bad: #ef6b90;
    --warn: #ffb347;
    --btn: #2e2550;
    --btn-h: #3d3268;
    --btn-line: rgba(242, 180, 65, 0.55);
    --gold-btn: #e8ad45;
    --gold-btn-h: #f5c25c;
    --dark-ink: #1b1230;
}

/* ---------- основа ---------- */
.app {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg);
    color: var(--ink);
    font-size: 13px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Regular.ttf");
}

.b {
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.hidden {
    display: none;
}

.muted {
    color: var(--muted);
}

.small {
    font-size: 11.5px;
}

.good {
    color: var(--ok);
}

.bad {
    color: var(--bad);
}

.warn {
    color: var(--warn);
}

.ok {
    color: #b6e07a;
}

.pen {
    color: var(--bad);
}

.icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.h2 {
    -unity-font: url("project://database/Assets/Iskra/Fonts/Philosopher-Bold.ttf");
    font-size: 17px;
    margin: 6px 0 4px 0;
    white-space: normal;
}

.h3 {
    -unity-font: url("project://database/Assets/Iskra/Fonts/Philosopher-Bold.ttf");
    font-size: 14px;
    margin: 12px 0 6px 0;
}

.p {
    white-space: normal;
    margin: 4px 0;
}

.note {
    white-space: normal;
    margin: 8px 0;
    padding: 8px 9px;
    border-radius: 8px;
    background-color: var(--gold-bg);
}

.note.bad {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--bad);
    color: var(--ink);
}

/* ---------- кнопки: тёмная с золотой каймой, основная — золотая, опасная — красная ---------- */
Button {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink);
    -unity-text-align: middle-center;
}

.btn,
.qup,
.qcyc,
.qdn,
.tab,
.tbtn,
.zbtn,
.sheetx,
.actmini {
    border-width: 1px;
    border-color: var(--btn-line);
    background-color: var(--btn);
    color: var(--ink);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
    transition-duration: 0.12s;
}

.btn:hover,
.qup:hover,
.qcyc:hover,
.qdn:hover,
.tab:hover,
.tbtn:hover,
.zbtn:hover,
.sheetx:hover,
.actmini:hover {
    background-color: var(--btn-h);
}

.btn:disabled,
.qup:disabled,
.actmini:disabled,
.actbtn:disabled {
    opacity: 0.42;
}

.btn.primary,
.qup.primary,
.qcyc,
.tab.on,
.tbtn.on,
.tplay.paused,
.actbtn {
    background-color: var(--gold-btn);
    border-color: var(--gold);
    color: var(--dark-ink);
}

.btn.primary:hover,
.qup.primary:hover,
.qcyc:hover,
.tab.on:hover,
.tbtn.on:hover,
.actbtn:hover {
    background-color: var(--gold-btn-h);
}

.btn.danger,
.qup.danger,
.qdn.armed {
    background-color: #d84a72;
    border-color: #ff8aa8;
    color: #ffffff;
}

.btn {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 38px;
    padding: 8px 16px;
    margin: 3px 0;
    border-radius: 19px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.btn.center,
.center-text {
    justify-content: center;
    -unity-text-align: middle-center;
}

.btn.center {
    align-self: center;
    min-width: 160px;
    margin-top: 14px;
}

.btn-col {
    flex-direction: column;
    align-items: flex-start;
    border-radius: 14px;
}

.btn-col > Label {
    white-space: normal;
}

.btn-sub {
    font-size: 11px;
    color: var(--muted);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Regular.ttf");
}

.btn.danger .btn-sub,
.btn.primary .btn-sub {
    color: var(--dark-ink);
}

.lnk {
    align-self: flex-start;
    color: var(--muted);
    padding: 4px 0;
    margin: 6px 0 0 0;
    -unity-text-align: middle-left;
}

.lnk:hover {
    color: var(--ink);
}

.qup {
    height: 30px;
    min-width: 40px;
    padding: 0 10px;
    border-radius: 15px;
    font-size: 12.5px;
    flex-shrink: 0;
}

.qup.grow {
    flex-grow: 1;
}

.qcyc {
    height: 30px;
    min-width: 44px;
    padding: 0 8px;
    border-radius: 15px;
    font-size: 12px;
}

.qdn {
    height: 30px;
    min-width: 30px;
    margin-left: 4px;
    border-radius: 15px;
    border-color: rgba(255, 120, 150, 0.6);
    color: #ff8aa8;
    font-size: 16px;
}

.qdn.armed {
    color: #ffffff;
}

/* ---------- поле ---------- */
.stage {
    flex-grow: 1;
    overflow: hidden;
    background-color: #120e22;
}

.map-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hexmap {
    flex-grow: 1;
    -unity-background-scale-mode: stretch-to-fill;
}

.hexmap-canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.map-label {
    position: absolute;
    text-shadow: 0 1px 2px rgba(8, 5, 20, 0.9);
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0;
    margin: 0;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Regular.ttf");
}

.map-label.b {
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.map-label.map-pill {
    padding: 1px 7px;
    border-radius: 9px;
}

/* шапка поверх поля: только текст */
.top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: 6px 8px 0 8px;
}

.res {
    flex-direction: row;
    justify-content: center;
}

.res-item {
    margin: 0 5px;
}

.res-item > .k {
    color: rgba(236, 230, 250, 0.75);
    font-size: 11.5px;
}

.res-item > .v {
    font-size: 15px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.res-item > .v.inc {
    color: var(--ok);
}

.res-item > .v.paused {
    color: var(--muted);
}

.feed {
    position: absolute;
    left: 10px;
    right: 60px;
    bottom: 60px;
    max-width: 420px;
    flex-direction: column-reverse;
}

.feed-item {
    margin-top: 5px;
    padding: 4px 8px;
    background-color: rgba(20, 16, 38, 0.88);
    border-left-width: 3px;
    border-color: #9a93b3;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 12px;
    white-space: normal;
    color: #e8e1f7;
    opacity: 1;
    transition-duration: 0.6s;
}

.feed-item.good {
    border-color: var(--gold);
}

.feed-item.bad {
    border-color: var(--bad);
}

.feed-item.info {
    border-color: var(--rare);
}

.feed-item.fade {
    opacity: 0;
}

/* управление временем */
.timectl {
    position: absolute;
    left: 10px;
    bottom: 10px;
    flex-direction: row;
    padding: 4px;
    border-radius: 22px;
    background-color: rgba(12, 9, 26, 0.72);
    border-width: 1px;
    border-color: rgba(242, 180, 65, 0.35);
}

.tbtn {
    min-width: 36px;
    height: 34px;
    margin-right: 4px;
    padding: 0 8px;
    border-radius: 17px;
    font-size: 13px;
}

.tplay {
    min-width: 40px;
}

.tbtn > .icon {
    width: 13px;
    height: 13px;
    align-self: center;
}

/* значки эры и прыжка */
.erabtn {
    position: absolute;
    top: 48px;
    max-width: 46%;
    padding: 0;
    align-items: flex-start;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
}

.erabtn:hover {
    opacity: 0.85;
}

.erapos {
    left: 10px;
}

.jumpbtn {
    right: 10px;
    align-items: flex-end;
    max-width: 42%;
}

.jumpbtn > Label {
    -unity-text-align: middle-right;
}

.jumpbtn.locked .eraname {
    color: #9a94b2;
}

.eraring {
    width: 38px;
    height: 38px;
    margin-bottom: 3px;
}

.eraname {
    font-size: 13px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.erasub {
    font-size: 11px;
    color: rgba(236, 230, 250, 0.8);
    white-space: normal;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.wtrend {
    font-size: 11px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.wtrend.grow {
    color: var(--ok);
}

.wtrend.stall {
    color: #d9cffa;
}

.wtrend.warn {
    color: var(--warn);
}

.wtrend.dark {
    color: var(--bad);
}

/* масштаб */
.zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
}

.zbtn {
    width: 38px;
    height: 38px;
    margin-top: 8px;
    border-radius: 19px;
}

.zbtn > .icon {
    width: 18px;
    height: 18px;
    align-self: center;
}

/* панель действия наверху поля */
.actbar {
    position: absolute;
    top: 140px;
    left: 50%;
    translate: -50% 0;
    max-width: 94%;
    flex-direction: row;
    align-items: center;
    padding: 6px;
    border-radius: 26px;
    border-width: 1px;
    border-color: rgba(242, 180, 65, 0.4);
    background-color: rgba(12, 9, 26, 0.85);
}

.actbtn {
    height: 36px;
    padding: 0 14px;
    border-radius: 18px;
    border-width: 1px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.actbtn > Label {
    font-size: 14px;
    color: var(--dark-ink);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.actbtn > .icon {
    margin-right: 6px;
    color: var(--dark-ink);
}

.actmini {
    height: 36px;
    min-width: 36px;
    padding: 0 10px;
    margin-left: 6px;
    border-radius: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.actmini > .icon {
    color: var(--gold);
}

.actmini > Label {
    font-size: 12px;
    margin-left: 3px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.fc {
    padding: 0 8px;
    flex-shrink: 1;
    justify-content: center;
}

.fc > Label {
    white-space: normal;
}

.fc-main {
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
    font-size: 15px;
}

.fc-sub {
    font-size: 11px;
    color: var(--muted);
}

.fc-main.good {
    color: var(--ok);
}

.fc-main.ok {
    color: #b6e07a;
}

.fc-main.warn {
    color: var(--warn);
}

.fc-main.bad {
    color: var(--bad);
}

.fc-sub.bad {
    color: var(--bad);
}

.fc-sub.warn {
    color: var(--warn);
}

.row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

/* ---------- окно раздела ---------- */
.sheet {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 12px;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 7, 22, 0.72);
}

.sheetbox {
    width: 100%;
    max-width: 900px;
    max-height: 100%;
    min-height: 55%;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--panel);
    padding-bottom: 8px;
    overflow: hidden;
}

.sheethd {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px 6px 16px;
    flex-shrink: 0;
}

.sheet-title {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/Iskra/Fonts/Philosopher-Bold.ttf");
    font-size: 17px;
}

.sheetx {
    width: 32px;
    height: 32px;
    border-radius: 16px;
}

.sheetx > .icon {
    width: 14px;
    height: 14px;
    align-self: center;
}

.menu-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.scroll-content {
    flex-shrink: 0;
}

.scroll-box {
    overflow: hidden;
}

.quick {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 9px 8px 9px;
}

.cols {
    flex-direction: row;
    flex-wrap: wrap;
    border-top-width: 1px;
    border-color: var(--line);
    padding: 2px 4px 12px 4px;
}

.col {
    flex-grow: 1;
    flex-basis: 300px;
    min-width: 250px;
    padding: 6px 10px;
}

/* ---------- нижняя строка вкладок ---------- */
.menu {
    flex-shrink: 0;
    background-color: var(--panel);
    border-top-width: 1px;
    border-color: var(--line);
}

.tabs {
    flex-direction: row;
    justify-content: space-around;
    padding: 6px 4px;
}

.tab {
    padding: 5px 10px;
    margin: 0 1px;
    border-radius: 16px;
    font-size: 13px;
    flex-shrink: 1;
}

.tab-tech {
    color: #9fe3ff;
}

.tab-tech.on {
    color: var(--dark-ink);
}

/* ---------- карточки ---------- */
.qg {
    flex-grow: 1;
    flex-basis: 92px;
    max-width: 200px;
    min-width: 80px;
    margin: 2px;
    padding: 4px 6px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 10px;
    background-color: var(--bg);
}

.qg.wide {
    flex-basis: 118px;
    max-width: 240px;
}

.qg.full {
    flex-basis: 100%;
    max-width: none;
}

.qg.warnq {
    border-color: var(--bad);
}

.qg.era-good {
    border-color: var(--ok);
}

.qg.era-bad {
    border-color: var(--bad);
}

.qg.era-mixed {
    border-color: var(--gold);
}

.qh {
    flex-direction: row;
    align-items: center;
    font-size: 15px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/Philosopher-Bold.ttf");
}

.qh > .icon {
    margin-right: 5px;
    color: var(--gold);
}

.qh-small {
    font-size: 12px;
    color: var(--muted);
    margin-left: 3px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Regular.ttf");
}

.qe {
    font-size: 12px;
    color: var(--muted);
    white-space: normal;
}

.qe.bad {
    color: var(--bad);
}

.qb {
    flex-direction: row;
    margin-top: 4px;
    align-items: center;
}

.qbld .spk {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 5px;
}

/* окно клетки: превью + карточки */
.cellwin {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 100%;
    align-items: flex-start;
}

.cell-preview {
    width: 96px;
    height: 96px;
    margin: 2px 6px 2px 2px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--line);
    background-color: #0f0b1e;
    flex-shrink: 0;
}

.cellside {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.cellside > .qg {
    flex-basis: 40%;
    max-width: none;
}

.cellside > .qg.wide {
    flex-basis: 100%;
}

/* строки «ключ — значение» */
.kv-row {
    flex-direction: row;
    justify-content: space-between;
    margin: 1px 0;
}

.kv-k {
    color: var(--muted);
    flex-shrink: 1;
    white-space: normal;
    margin-right: 10px;
    font-size: 12.5px;
}

.kv-v {
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
    -unity-text-align: middle-right;
    flex-shrink: 0;
    font-size: 12.5px;
}

/* шкалы материи / энергии / силы */
.srow {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.srow > .n {
    width: 66px;
    color: var(--muted);
    font-size: 12px;
}

.track {
    flex-grow: 1;
    height: 7px;
    border-radius: 4px;
    background-color: var(--line);
    overflow: hidden;
    margin-right: 8px;
}

.track-fill {
    height: 100%;
}

.srow > .v {
    width: 40px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
    -unity-text-align: middle-right;
}

.srow > .m {
    width: 44px;
    font-size: 11.5px;
    color: var(--muted);
    -unity-text-align: middle-right;
}

.prog {
    height: 6px;
    border-radius: 3px;
    background-color: var(--line);
    overflow: hidden;
    margin: 4px 0;
}

.prog-fill {
    height: 100%;
    background-color: var(--gold);
}

.tier-tag {
    font-size: 11px;
    padding: 0 7px;
    border-radius: 9px;
    border-width: 1px;
    margin-left: 6px;
    align-self: center;
}

.tier-tag.low {
    color: var(--low);
    border-color: var(--low);
}

.tier-tag.rare {
    color: var(--rare);
    border-color: var(--rare);
}

.tier-tag.epic {
    color: var(--epic);
    border-color: var(--epic);
}

.tier-tag.legend {
    color: #ffffff;
    background-color: var(--legend);
    border-color: var(--legend);
}

.tier-tag.dist {
    color: var(--muted);
    border-color: var(--muted);
}

.list-item {
    padding: 3px 0;
}

.list-item > .sub {
    font-size: 11.5px;
    color: var(--muted);
    white-space: normal;
}

.eli {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px 6px;
    margin: 2px 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
}

.eli > .icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    color: var(--gold);
}

.eli.good {
    border-left-color: var(--ok);
}

.eli.good > .icon {
    color: var(--ok);
}

.eli.bad {
    border-left-color: var(--bad);
}

.eli.bad > .icon {
    color: var(--bad);
}

.eli.mixed {
    border-left-color: var(--gold);
}

.eli.now {
    background-color: var(--gold-bg);
}

.eli-text {
    flex-shrink: 1;
}

.eli-text > Label {
    white-space: normal;
}

/* способности в окне */
.ab-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 160px;
    min-height: 42px;
    margin: 2px;
    padding: 3px 4px 3px 7px;
    border-width: 1px;
    border-left-width: 3px;
    border-color: var(--line);
    border-radius: 9px;
    background-color: var(--bg);
}

.ab-row > .icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.ab-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 4px;
}

.ab-text > Label {
    white-space: normal;
}

.ab-name {
    -unity-font: url("project://database/Assets/Iskra/Fonts/Philosopher-Bold.ttf");
    font-size: 14px;
}

.ab-row.empty {
    opacity: 0.6;
}

.qside {
    flex-basis: 100%;
    max-width: none;
}

/* артефакты */
.aslots {
    flex-direction: row;
    flex-wrap: wrap;
    flex-basis: 100%;
}

.aslot {
    width: 15%;
    flex-grow: 1;
    height: 48px;
    margin: 3px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(242, 180, 65, 0.45);
    background-color: var(--bg);
    align-items: center;
    justify-content: center;
}

.aslot:hover {
    background-color: var(--gold-bg);
}

.aslot:disabled {
    opacity: 0.45;
}

.aslot.empty {
    border-color: var(--line);
    background-color: rgba(0, 0, 0, 0);
}

.aslot > .icon {
    width: 20px;
    height: 20px;
}

.aslot > Label {
    font-size: 11.5px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

/* персонаж: покупка ОП и диаграмма */
.oprow {
    flex-direction: row;
    align-items: center;
    flex-basis: 100%;
    margin: 2px;
    padding: 5px 8px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    background-color: var(--bg);
}

.oprow > Label {
    margin-right: 5px;
    font-size: 12px;
}

.oprow > .opn {
    font-size: 17px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.oprow > .qup,
.oprow > .qcyc {
    margin-right: 5px;
    height: 28px;
}

.oprow > .icon {
    color: var(--gold);
    margin-right: 4px;
}

.radar {
    width: 100%;
    max-width: 560px;
    height: 380px;
    align-self: center;
    margin-top: 4px;
}

.radar-canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.rlab {
    position: absolute;
    width: 33%;
    align-items: center;
    translate: -50% -50%;
}

.rlab > Label {
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--muted);
}

.rlab > .rn {
    font-size: 11.5px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.rlab > .rlv {
    font-size: 14px;
    color: var(--ink);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.rlab > .rlv.pen {
    color: var(--bad);
}

.rlab > .qup {
    height: 26px;
    min-width: 52px;
    margin: 2px 0;
}

.rnote {
    flex-basis: 100%;
    font-size: 11px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* технологии */
.ttree {
    flex-basis: 100%;
    align-items: stretch;
}

.tpbar {
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding: 4px 12px;
    margin-bottom: 8px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(159, 227, 255, 0.4);
}

.tpbar > .icon {
    color: #9fe3ff;
    margin-right: 4px;
}

.tl1 {
    font-size: 11px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin: 4px 0 2px 0;
}

.tlvl {
    flex-direction: row;
    justify-content: center;
}

.tnode {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 200px;
    margin: 3px;
    padding: 8px 6px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--bg);
    align-items: center;
}

.tnode.done {
    border-color: var(--gold);
}

.tnode.open {
    border-color: rgba(159, 227, 255, 0.6);
}

.tnode.locked,
.tnode.soon {
    opacity: 0.55;
}

.tnode > .icon {
    width: 30px;
    height: 30px;
    margin-bottom: 4px;
    color: #9fe3ff;
}

.tnode.done > .icon {
    color: var(--gold);
}

.tnode > Label {
    white-space: normal;
    -unity-text-align: middle-center;
}

.tnode > .tst {
    font-size: 12px;
    color: var(--muted);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.tnode.done > .tst {
    color: var(--gold);
}

/* ---------- окна ---------- */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 7, 22, 0.72);
    align-items: center;
    justify-content: center;
    padding: 12px;
}

.box {
    width: 100%;
    max-width: 640px;
    max-height: 100%;
    padding: 18px 18px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--panel);
}

.facts {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.facts > .btn {
    margin-left: 8px;
    min-width: 110px;
    justify-content: center;
    -unity-text-align: middle-center;
}

.jcols {
    flex-direction: row;
    flex-wrap: wrap;
}

.jcols > VisualElement {
    flex-grow: 1;
    flex-basis: 240px;
    margin: 0 6px;
}

.defbox {
    max-width: 440px;
}

.defbox > .h2 {
    color: var(--bad);
}

.defbox .fc {
    margin: 10px 0;
    padding: 0;
}

/* бой */
.battle-box {
    max-width: 640px;
}

.fighters {
    flex-direction: row;
    align-items: flex-end;
}

.fighter {
    flex-grow: 1;
    flex-basis: 0;
}

.fname {
    font-size: 18px;
    margin-bottom: 6px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/Philosopher-Bold.ttf");
}

.fname-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 6px;
}

.fname-row > .fname {
    margin-bottom: 0;
}

.vs {
    margin: 0 10px 26px 10px;
    color: var(--muted);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Italic.ttf");
}

.bar {
    height: 12px;
    margin: 3px 0;
    border-radius: 6px;
    background-color: var(--line);
    overflow: hidden;
}

.bar.cd {
    height: 5px;
}

.bar-fill {
    height: 100%;
    width: 100%;
}

.bar.hp > .bar-fill {
    background-color: var(--ok);
}

.bar.foe-hp > .bar-fill {
    background-color: var(--epic);
}

.bar.cd > .bar-fill {
    background-color: var(--gold);
}

.bar.foe-cd > .bar-fill {
    background-color: var(--violet);
}

.bnum {
    font-size: 13px;
    color: var(--muted);
}

.bfx {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 18px;
    margin-top: 4px;
}

.bffx {
    justify-content: flex-end;
}

.fxtag {
    font-size: 11.5px;
    padding: 0 7px;
    margin: 2px 4px 0 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--line);
    color: var(--ink);
}

.fxtag.trait {
    color: var(--muted);
}

.fxtag.on {
    border-color: var(--bad);
    color: var(--bad);
}

.fxtag.off {
    opacity: 0.45;
}

.arena-host {
    height: 170px;
    margin: 12px 0 8px 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--line);
    overflow: hidden;
    background-color: #07050f;
}

.arena {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.bstart {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.bfc {
    padding: 5px 10px;
    margin-right: 10px;
    border-radius: 12px;
    background-color: rgba(12, 9, 26, 0.8);
    align-items: center;
}

.bfc > .fc-main {
    font-size: 15px;
}

.bstatus {
    white-space: normal;
    margin: 10px 0 6px 0;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.bactions {
    flex-direction: row;
    flex-wrap: wrap;
}

.abi {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 64px;
    margin: 2px;
    padding: 5px 3px 6px 3px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(242, 180, 65, 0.4);
    background-color: var(--bg);
    align-items: center;
}

.abi:hover {
    background-color: var(--btn);
}

.abi > .cost {
    font-size: 11.5px;
    color: var(--gold);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.abi.poor > .cost {
    color: var(--bad);
}

.dial {
    width: 52px;
    height: 52px;
    margin: 3px 0;
}

.dial > .cdt {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

.dial > .kk {
    position: absolute;
    right: -3px;
    bottom: -3px;
    width: 17px;
    height: 17px;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--panel);
    font-size: 10px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

.abi > .nm {
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.abi:disabled {
    opacity: 0.85;
}

.choice {
    flex-basis: 100%;
}

.choice Label {
    white-space: normal;
}

.bactions > .btn {
    flex-basis: 100%;
}

.blogw {
    border-top-width: 1px;
    border-color: var(--line);
    padding-top: 8px;
    align-self: stretch;
}

.blog {
    max-height: 120px;
    margin-top: 4px;
    overflow: hidden;
}

.blog-text {
    font-size: 12.5px;
    white-space: normal;
    color: var(--muted);
}

.bfoot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
}

.bfoot > .btn {
    min-width: 120px;
}

/* в UI Toolkit элементы по умолчанию сжимаются ниже своего содержимого — текст в окнах налезал бы друг на друга */
.p,
.h2,
.h3,
.note,
.btn,
.facts,
.kv,
.kv-row,
.bstatus,
.fighters,
.bfoot,
.bactions,
.jcols,
.list-item,
.eli,
.tabs,
.tab {
    flex-shrink: 0;
}

/* кнопки с иконкой: содержимое строго по центру */
.tbtn,
.zbtn,
.sheetx,
.actmini,
.qup,
.qcyc,
.qdn {
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
}

.tbtn > .icon,
.zbtn > .icon,
.sheetx > .icon,
.actmini > .icon {
    align-self: center;
    margin: 0;
}

.actbtn {
    justify-content: center;
}

/* окно «Способности»: слева покупка ОС, справа список ячеек в одну колонку */
.qrows {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 220px;
    min-width: 200px;
}

.qrows > .ab-row {
    flex-basis: auto;
    flex-grow: 0;
    width: auto;
}

.qside {
    flex-grow: 0;
    flex-basis: 150px;
    min-width: 140px;
    max-width: none;
}

.qside .qb > .qup,
.qside .qb > .qcyc {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 4px;
}

.nowtag {
    margin-left: 6px;
    color: var(--gold);
    -unity-font: url("project://database/Assets/Iskra/Fonts/PTSans-Bold.ttf");
}

/* колонки окна: рядом — с вертикальной чертой, друг под другом — с горизонтальной */
.cols > #colB {
    border-color: var(--line);
}

.cols.split > #colB {
    border-left-width: 1px;
}

.cols.stacked > #colB {
    border-top-width: 1px;
}
